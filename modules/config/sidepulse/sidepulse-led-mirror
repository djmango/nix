#!/usr/bin/env python3
"""SidePulse socket -> LED mirror (non-GUI, deterministic, sleep-aware).

Drives the SidePulse LEDs from agent status events published over the status
bar unix socket (used by the Cursor and Hermes bridges). Status-only: it never
reads, logs, or stores chat content.

Behavior:
  - Each bridge event carries an explicit `sidepulse_status` token
    (working / done / ask / blocked / idle) mapped directly to the LED
    animation: working cyan slinky, done solid green, ask amber pulse,
    blocked red, idle dim. No priority-merge, so a lingering "done" can never
    mask a new ask/idle.
  - IDLE_AFTER_SECONDS with no events -> idle, so it never stays lit forever.
  - OFF unless the user can actually see the strip: lid closed or display
    asleep blanks the LEDs within a second, even when something keeps the Mac
    awake (caffeinate, external media, clamshell mode) and even though our own
    keepalive keeps the device powered.
  - INIT.LED is rewritten to a dark program on start and on every re-mount, so
    the firmware's magenta power-up fill can never flash on wake.
  - Mode changes are debounced (MIN_MODE_HOLD_SECONDS) so hook bursts
    (done -> working milliseconds apart) do not strobe the strip.
  - On macOS sleep -> LEDs turn fully OFF; on wake -> reflects current status.
  - Keeps the device awake and re-syncs if a write failed or the device
    re-mounted.
"""

import re
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path

CONFIG = Path.home() / ".local" / "state" / "sidepulse" / "agent-monitor"
KEEPALIVE = "/Volumes/SidePulse/keepalive"
DEVICE_LED_FILE = "/Volumes/SidePulse/LEDS.LED"
IDLE_AFTER_SECONDS = 5 * 60  # no events for this long -> show Idle

# Startup program. The firmware plays INIT.LED on power up; the factory content
# is a magenta fill that flashes every time the SD reader re-powers the device
# (sleep/wake cycles, and the 3-minute inactivity power-off).
INIT_LED_FILE_NAME = "INIT.LED"
INIT_LED_PROGRAM = "off"

# Hook bursts (done -> working within milliseconds) must not strobe the strip.
MIN_MODE_HOLD_SECONDS = 1.5
# Lid / display-asleep polling cadence.
PRESENCE_POLL_SECONDS = 1.0
# Retry cadence after a failed LED write.
WRITE_RETRY_SECONDS = 5.0
# Grace period after the device re-mounts before writing to it again.
DEVICE_SETTLE_SECONDS = 2.0
# Used only if brightness is unreadable from the very first second on.
FALLBACK_BRIGHTNESS_RATIO = 0.5

from sidepulse.led_status import (
    DEFAULT_FILE_NAME,
    resolve_target_path,
    write_led_program,
    write_mode_to_leds,
)
from sidepulse.models import AgentMode

# Explicit bridge status token -> sidepulse animation mode.
TOKEN_TO_MODE = {
    "working": AgentMode.WORKING,
    "done": AgentMode.COMPLETED,
    "ask": AgentMode.WAITING_FOR_INPUT,
    "blocked": AgentMode.BLOCKED_ERROR,
    "idle": AgentMode.IDLE_READY,
}


def log(msg: str) -> None:
    print(f"{datetime.now(timezone.utc).isoformat()} {msg}", flush=True)


def device_present() -> bool:
    return Path(DEVICE_LED_FILE).exists()


def _display_services_ratio() -> float | None:
    """Control Center / keyboard brightness, 0.0-1.0. None if unavailable."""
    try:
        import ctypes
        from ctypes import POINTER, c_float, c_int, c_uint32

        cg = ctypes.CDLL("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
        ds = ctypes.CDLL(
            "/System/Library/PrivateFrameworks/DisplayServices.framework/DisplayServices"
        )
        cg.CGMainDisplayID.restype = c_uint32
        ds.DisplayServicesGetBrightness.argtypes = [c_uint32, POINTER(c_float)]
        ds.DisplayServicesGetBrightness.restype = c_int
        val = c_float()
        rc = ds.DisplayServicesGetBrightness(cg.CGMainDisplayID(), ctypes.byref(val))
        if rc == 0 and 0.0 <= val.value <= 1.0:
            return float(val.value)
    except Exception:
        return None
    return None


def _ioreg_nits_ratio(out: str) -> float | None:
    m = re.search(r'"BrightnessMilliNits"\s*=\s*\{([^}]*)\}', out)
    if not m:
        return None
    body = m.group(1)
    vm = re.search(r'"value"=(\d+)', body)
    xm = re.search(r'"max"=(\d+)', body)
    if not vm or not xm:
        return None
    maximum = int(xm.group(1))
    if maximum <= 0:
        return None
    return max(0.0, min(1.0, int(vm.group(1)) / maximum))


def system_brightness_ratio() -> float | None:
    """Current display brightness as a 0.0-1.0 ratio, or None if unreadable.

    DisplayServices tracks the Control Center slider. The AppleARMBacklight
    `brightness` 16-bit key sits at 50% on this hardware and is the wrong
    source — that is why the LEDs stayed at `brightness 128` (looks full-on)
    while the Mac was dimmed. BrightnessMilliNits is the ioreg fallback.

    Returns None instead of 1.0 when nothing can be read: the old
    full-brightness fallback lit the strip up exactly when the display was off
    (lid shut, display sleep), which is when it must be dark. The caller keeps
    the last known good ratio instead.
    """
    ratio = _display_services_ratio()
    if ratio is not None:
        return ratio
    try:
        out = subprocess.run(
            ["/usr/sbin/ioreg", "-rc", "AppleARMBacklight"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        ).stdout
        return _ioreg_nits_ratio(out)
    except Exception:
        return None


def _ioreg_bool(property_name: str, args: list[str]) -> bool | None:
    try:
        out = subprocess.run(
            ["/usr/sbin/ioreg", *args],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        ).stdout
    except Exception:
        return None
    m = re.search(rf'"{re.escape(property_name)}"\s*=\s*(Yes|No|true|false|1|0)', out, re.I)
    if not m:
        return None
    return m.group(1).lower() in {"yes", "true", "1"}


def lid_closed() -> bool | None:
    """AppleClamshellState: True when the lid is shut, None if unreadable."""
    return _ioreg_bool("AppleClamshellState", ["-r", "-k", "AppleClamshellState", "-d", "4"])


def _display_asleep() -> bool | None:
    """True when the main display is asleep (idle display sleep or lid shut)."""
    try:
        import ctypes
        from ctypes import c_int, c_uint32

        cg = ctypes.CDLL("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
        cg.CGMainDisplayID.restype = c_uint32
        cg.CGDisplayIsAsleep.argtypes = [c_uint32]
        cg.CGDisplayIsAsleep.restype = c_int
        return bool(cg.CGDisplayIsAsleep(cg.CGMainDisplayID()))
    except Exception:
        return None


def leds_should_be_dark() -> bool:
    """True when nobody can see the strip.

    Only positive readings count: a probe that returns None (sensor hiccup,
    missing key) is ignored, so a failed check can never blank the strip while
    the user is actually looking at it.
    """
    if lid_closed() is True:
        return True
    if _display_asleep() is True:
        return True
    return False


def main() -> int:
    current_mode: AgentMode = AgentMode.IDLE_READY
    brightness_ratio: float | None = system_brightness_ratio()
    if brightness_ratio is None:
        brightness_ratio = FALLBACK_BRIGHTNESS_RATIO
    last_brightness_at = 0.0
    written_ok = True
    last_retry_at = 0.0
    last_event_at = time.monotonic()
    last_device_seen = device_present()
    leds_hidden = False
    last_presence_check = 0.0
    pending_mode: AgentMode | None = None
    last_mode_change_at = 0.0

    def write_current(mode: AgentMode, *, force: bool = False) -> None:
        nonlocal written_ok
        if leds_hidden and not force:
            return
        led_brightness = max(0, min(255, int(round(brightness_ratio * 255))))
        try:
            write_mode_to_leds(mode, brightness=led_brightness)
            log(f"leds={mode.value} bright={led_brightness} ({round(brightness_ratio * 100)}%)")
            written_ok = True
        except Exception as exc:
            written_ok = False
            log(f"led write error ({mode.value}): {exc}")

    def write_off(reason: str) -> None:
        try:
            target = resolve_target_path(device_path=None, file_name=DEFAULT_FILE_NAME)
            write_led_program("off", device_path=target)
            log(f"leds=off ({reason})")
        except Exception as exc:
            log(f"off write error ({reason}): {exc}")

    def write_dark_init() -> None:
        """Replace the firmware's magenta power-up fill with a dark program."""
        try:
            target = resolve_target_path(device_path=None, file_name=INIT_LED_FILE_NAME)
        except Exception as exc:
            log(f"init write skipped: {exc}")
            return
        try:
            if (
                target.exists()
                and target.read_text(encoding="utf-8", errors="replace").strip()
                == INIT_LED_PROGRAM
            ):
                return
            # Pass the device root, not the file: write_led_program appends the
            # file name itself and would otherwise mkdir() on top of the file.
            write_led_program(
                INIT_LED_PROGRAM, device_path=target.parent, file_name=INIT_LED_FILE_NAME
            )
            log("init=dark (power-up flash disabled)")
        except Exception as exc:
            log(f"init write error: {exc}")

    def set_mode(mode: AgentMode, *, force: bool = False) -> None:
        nonlocal current_mode, last_mode_change_at, pending_mode
        current_mode = mode
        pending_mode = None
        last_mode_change_at = time.monotonic()
        write_current(mode, force=force)

    def apply(token: str) -> None:
        nonlocal pending_mode
        mode = TOKEN_TO_MODE.get(token)
        if mode is None or mode == current_mode:
            return
        if time.monotonic() - last_mode_change_at < MIN_MODE_HOLD_SECONDS:
            # Hold the current animation a beat; the newest token still lands.
            pending_mode = mode
            return
        set_mode(mode)

    # --- Unix socket server (background thread) ---------------------------
    import json
    import socket
    import threading

    sock_path = CONFIG / "events.sock"

    def on_event(provider: str, line: dict) -> None:
        nonlocal last_event_at
        token = line.get("sidepulse_status") if isinstance(line, dict) else None
        if isinstance(token, str):
            last_event_at = time.monotonic()
            apply(token)

    def server_thread() -> None:
        try:
            sock_path.unlink()
        except FileNotFoundError:
            pass
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(str(sock_path))
        server.listen(16)
        server.settimeout(1.0)
        log(f"listening={sock_path}")
        try:
            while True:
                try:
                    conn, _ = server.accept()
                except socket.timeout:
                    continue
                except OSError:
                    return
                with conn:
                    chunks: list[bytes] = []
                    while True:
                        try:
                            chunk = conn.recv(65536)
                        except OSError:
                            break
                        if not chunk:
                            break
                        chunks.append(chunk)
                    try:
                        msg = json.loads(b"".join(chunks).decode("utf-8"))
                        if isinstance(msg, dict):
                            on_event(str(msg.get("provider", "")), msg.get("line") or {})
                    except Exception as exc:
                        log(f"event parse error: {exc}")
        except Exception as exc:
            log(f"server error: {exc}")
        finally:
            server.close()

    threading.Thread(target=server_thread, daemon=True).start()

    # --- Sleep / wake notifications (NSWorkspace, runloop-pumped) ---------
    def on_wake() -> None:
        nonlocal leds_hidden
        # Re-check immediately: a wake with the lid still shut stays dark, so
        # we never light the strip for the quarter-second before the poll.
        leds_hidden = leds_should_be_dark()
        write_current(current_mode)

    try:
        import Foundation
        from AppKit import NSWorkspace

        nc = NSWorkspace.sharedWorkspace().notificationCenter()
        nc.addObserverForName_object_queue_usingBlock_(
            "NSWorkspaceWillSleepNotification", None, None,
            lambda _note: write_off("sleep"),
        )
        nc.addObserverForName_object_queue_usingBlock_(
            "NSWorkspaceDidWakeNotification", None, None,
            lambda _note: on_wake(),
        )
        runloop = Foundation.NSRunLoop.currentRunLoop()
        have_runloop = True
        log("power notifications registered")
    except Exception as exc:
        runloop = None
        have_runloop = False
        log(f"power monitoring unavailable: {exc}")

    # Device power-up program, then initial state.
    write_dark_init()
    leds_hidden = leds_should_be_dark()
    write_current(current_mode, force=True)
    if leds_hidden:
        write_off("lid closed / display asleep at start")

    last_keepalive = 0.0
    try:
        while True:
            if have_runloop:
                runloop.runMode_beforeDate_(
                    Foundation.NSDefaultRunLoopMode,
                    Foundation.NSDate.dateWithTimeIntervalSinceNow_(0.25),
                )
            else:
                time.sleep(0.25)

            now = time.monotonic()
            present = device_present()

            # Dark whenever the lid is shut or the display is asleep.
            if now - last_presence_check >= PRESENCE_POLL_SECONDS:
                last_presence_check = now
                dark = leds_should_be_dark()
                if dark and not leds_hidden:
                    leds_hidden = True
                    write_off("lid closed / display asleep")
                elif not dark and leds_hidden:
                    leds_hidden = False
                    log("lid open / display awake")
                    # Show the newest status straight away: a mode that queued
                    # up while the lid was shut must not flash the older one.
                    if pending_mode is not None:
                        set_mode(pending_mode, force=True)
                    else:
                        write_current(current_mode, force=True)

            # Follow system brightness (only scales LEDs; animation unchanged).
            # Re-read at most once a second so slider changes show up quickly.
            # An unreadable brightness keeps the last known value.
            if present and now - last_brightness_at >= 1.0:
                last_brightness_at = now
                ratio = system_brightness_ratio()
                if ratio is not None:
                    brightness_changed = abs(ratio - brightness_ratio) >= 0.03
                    brightness_ratio = ratio
                    if brightness_changed and not (
                        current_mode == AgentMode.IDLE_READY and not written_ok
                    ):
                        write_current(current_mode)

            # Flush a debounced mode change once the hold window has passed.
            if (
                pending_mode is not None
                and not leds_hidden
                and now - last_mode_change_at >= MIN_MODE_HOLD_SECONDS
            ):
                set_mode(pending_mode)

            # Fall back to Idle after inactivity.
            if current_mode != AgentMode.IDLE_READY and now - last_event_at > IDLE_AFTER_SECONDS:
                set_mode(AgentMode.IDLE_READY)

            # Recover from a transient write failure or device re-mount.
            if present and not written_ok and now - last_retry_at >= WRITE_RETRY_SECONDS:
                last_retry_at = now
                write_current(current_mode)
            if present and not last_device_seen:
                log("device re-mounted; resyncing LEDs")
                # Let the firmware finish its power-up sequence before writing:
                # a write landing mid-boot is what makes the strip blink red.
                time.sleep(DEVICE_SETTLE_SECONDS)
                write_dark_init()
                write_current(current_mode, force=True)
            last_device_seen = present

            if present and now - last_keepalive >= 60:
                try:
                    subprocess.run(
                        ["/usr/bin/touch", KEEPALIVE],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        timeout=2,
                        check=False,
                    )
                    last_keepalive = now
                except Exception:
                    pass
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())